{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "2do",
  "title": "2Do",
  "description": "Add, view, and edit 2Do tasks.",
  "icon": "icon.png",
  "author": "danielhaven",
  "categories": [
    "Productivity"
  ],
  "keywords": [
    "2do",
    "todo",
    "tasks",
    "task manager",
    "reminders",
    "gtd"
  ],
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "add-task",
      "title": "Add Task",
      "description": "Add a task to 2Do.",
      "mode": "view"
    },
    {
      "name": "add-link",
      "title": "Add Link",
      "description": "Add a web page to 2Do as a task, titled and described from the page.",
      "mode": "view"
    },
    {
      "name": "view-tasks",
      "title": "View Tasks",
      "description": "Browse 2Do tasks by scope, list, or smart list, and edit, complete, or open them.",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "cancelBehavior",
      "title": "Cancel Task",
      "description": "What the Cancel Task action does.",
      "type": "dropdown",
      "required": false,
      "default": "complete-and-tag",
      "data": [
        {
          "title": "Complete and Tag",
          "value": "complete-and-tag"
        },
        {
          "title": "Tag Only",
          "value": "tag"
        },
        {
          "title": "Move to List and Complete",
          "value": "move"
        },
        {
          "title": "Delete",
          "value": "delete"
        }
      ]
    },
    {
      "name": "cancelTag",
      "title": "Cancel Tag",
      "description": "The 2Do tag that marks a cancelled task. It must already exist in 2Do.",
      "type": "textfield",
      "required": false,
      "default": "Cancelled"
    },
    {
      "name": "cancelList",
      "title": "Cancel List",
      "description": "The 2Do list cancelled tasks move to, for \"Move to List and Complete\".",
      "type": "textfield",
      "required": false,
      "default": ""
    }
  ],
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "2.7.3",
    "@raycast/utils": "2.3.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "2.2.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
